generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scholarship {
  id          String    @id @default(cuid())
  name        String
  status      Status    @default(RESEARCHING)
  deadline    DateTime?
  link        String?
  description String?
  country     String?
  funding     String?
  notes       String?
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id            String      @id @default(cuid())
  title         String
  done          Boolean     @default(false)
  dueDate       DateTime?
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
}

enum Status {
  RESEARCHING
  APPLYING
  SUBMITTED
  INTERVIEW
  ACCEPTED
  REJECTED
}